# Banco de dados (Postgres). Recomendado: Vercel Postgres (Neon) - gratuito pra começar.
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Mercado Pago - pegue em https://www.mercadopago.com.br/developers/panel/app
# Use o Access Token de PRODUÇÃO quando for pra rifa valendo dinheiro de verdade.
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL pública do site (usada no webhook do Mercado Pago). Em produção é a URL da Vercel.
BASE_URL="https://sua-rifa.vercel.app"

# Configurações da rifa
RAFFLE_TITLE="Rifa Beneficente"
RAFFLE_PRICE="10"
RAFFLE_TOTAL_NUMBERS="1000"
RESERVE_MINUTES="15"

# Login do painel admin
ADMIN_USER="admin"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_SECRET="uma-string-bem-aleatoria-e-longa-aqui"

# Protege o endpoint de cron (a Vercel envia esse valor automaticamente no header Authorization
# quando essa env var está configurada no projeto)
CRON_SECRET="outra-string-bem-aleatoria"

# Protege o endpoint /api/setup (cria a tabela e popula os números pelo navegador, sem terminal)
SETUP_SECRET="mais-uma-string-bem-aleatoria"
